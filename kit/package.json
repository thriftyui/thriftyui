{
  "name": "thriftyui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React components on Radix Primitives and Radix Colors, styled with Tailwind CSS.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./themes.css": "./dist/themes.css",
    "./patterns.css": "./dist/patterns.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./drawer-host": null,
    "./sheet-drag": null,
    "./input-modality": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && cp src/theme.css src/themes.css src/patterns.css src/shadcn.css dist/",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.4"
  },
  "homepage": "https://www.thriftyui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thriftyui/thriftyui.git",
    "directory": "kit"
  },
  "bugs": {
    "url": "https://github.com/thriftyui/thriftyui/issues"
  }
}
